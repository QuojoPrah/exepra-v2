{
  "name": "exepra-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "prisma dev -n exepra --detach",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:seed:setup": "SEED_DEMO_PRODUCTS=false prisma db seed",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "cloudinary:setup": "tsx scripts/cloudinary-setup.ts",
    "resend:setup": "tsx scripts/resend-setup.ts",
    "stripe:setup:live": "tsx scripts/stripe-setup.ts --live"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.22",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.29",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^31.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
