# ─────────────────────────────────────────────────────────────────────────────
# EXEPRA — environment variables
# Copy to `.env` for local development. In production set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for canonical URLs, sitemap, emails, Stripe redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Runtime connection. On Neon use the *pooled* connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. On Neon: the unpooled URL.
DIRECT_URL=""
# Max connections per server instance (keep small on serverless). Use 1 with local `prisma dev`.
DATABASE_POOL_MAX=5

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Same as NEXT_PUBLIC_SITE_URL in most setups.
BETTER_AUTH_URL="http://localhost:3000"

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Test keys start with sk_test_/pk_test_; live keys with sk_live_/pk_live_.
STRIPE_SECRET_KEY=""
# Not required by the hosted Checkout flow; reserved for future embedded payment UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint https://YOUR-DOMAIN/api/webhooks/stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. "EXEPRA <orders@your-domain.de>"
EMAIL_FROM=""
# Optional reply-to address for customer replies
EMAIL_REPLY_TO=""
# Optional: where contact-form notifications go (defaults to the contact email in Admin → Settings)
STORE_NOTIFICATION_EMAIL=""

# ── Image storage (Cloudinary) ───────────────────────────────────────────────
# Required for admin image uploads in production. In development, uploads fall
# back to /public/uploads when these are empty.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics (optional, loads only after visitor consent) ───────────────────
# Plausible site domain, e.g. "your-domain.de"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Protects /api/cron/release-stock. Vercel sends it automatically as a Bearer token.
CRON_SECRET=""

# ── Testing only (local) ─────────────────────────────────────────────────────
# Credentials of a local test admin used by the Playwright suite. Never set in production.
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
